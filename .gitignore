# 品牌资产脚本的 Python 编译缓存不提交到仓库。
__pycache__/
*.py[cod]

# Android 工程只提交源码，构建缓存、本机 SDK 路径和签名材料不得进入仓库。
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.jks
*.keystore
keystore.properties

# 在线更新签名私钥和本机环境变量绝不能提交；公钥 .key.pub 可以公开。
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example
android/signing.properties
release-output/
